          "text" : {
            "type" : "string",
            "maxLength" : 5000,
            "minLength" : 0
          },
          "speaker" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "startMs" : {
            "type" : "integer",
            "format" : "int64",
