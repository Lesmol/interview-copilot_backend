          "sessionId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string"
          },
          "text" : {
            "type" : "string"
          },
          "quote" : {
            "type" : "string"
          },
          "sourceSeqs" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "status" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "Whoami" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string"
          },
          "clientId" : {
            "type" : "string"
          }
        }
      },
      "SpeechToken" : {
        "type" : "object",
        "properties" : {
          "provider" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string"
          },
          "expiresInSeconds" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "SseEmitter" : {
        "type" : "object",
        "properties" : {
          "timeout" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      }
    }
  }
}
