          "title" : {
            "type" : "string"
          },
          "interviewee" : {
            "type" : "string"
          },
          "angle" : {
            "type" : "string"
          },
          "interviewType" : {
            "type" : "string"
          },
          "suggestionTypes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "uniqueItems" : true
          },
          "frequency" : {
            "type" : "string"
