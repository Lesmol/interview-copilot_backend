          "startMs" : {
            "type" : "integer",
            "format" : "int64"
          },
          "endMs" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "SignUpRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
