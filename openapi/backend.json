            },
            "uniqueItems" : true
          },
          "frequency" : {
            "type" : "string"
          }
        },
        "required" : [ "title" ]
      },
      "SessionView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
