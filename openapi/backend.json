          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 10
          }
        },
        "required" : [ "email", "name", "password" ]
      },
      "PasswordResetRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      },
      "PasswordResetConfirmation" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "newPassword" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 10
          }
        },
        "required" : [ "newPassword", "token" ]
      },
      "UpdateSuggestion" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "status" ]
      },
      "Suggestion" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
